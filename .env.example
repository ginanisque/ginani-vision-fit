# Server-only Neon configuration
DATABASE_URL=postgresql://USER:PASSWORD@POOLED_HOST/DB?sslmode=require
DATABASE_URL_POOLED=postgresql://USER:PASSWORD@POOLED_HOST/DB?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@DIRECT_HOST/DB?sslmode=require
NEON_AUTH_BASE_URL=https://YOUR-AUTH-ENDPOINT.neonauth.REGION.aws.neon.tech/YOUR_PROJECT/auth
NEON_AUTH_JWKS_URL=https://YOUR-AUTH-ENDPOINT.neonauth.REGION.aws.neon.tech/YOUR_PROJECT/auth/.well-known/jwks.json

# Private Neon Object Storage (S3-compatible)
AWS_ENDPOINT_URL_S3=https://YOUR-STORAGE-ENDPOINT
AWS_ACCESS_KEY_ID=YOUR_STORAGE_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_STORAGE_SECRET_KEY
S3_REGION=YOUR_STORAGE_REGION
S3_BUCKET=YOUR_PRIVATE_BUCKET

# Application access
VISIONFIT_BOOTSTRAP_ADMIN_EMAILS=admin@example.com
VISIONFIT_CORS_ORIGINS=http://localhost:5173

# Optional measurement-vision provider. Keep disabled until the privacy notice
# explicitly covers Roboflow-hosted processing and both custom workflows exist.
ROBOFLOW_ENABLED=false
ROBOFLOW_API_KEY=
ROBOFLOW_WORKSPACE=
ROBOFLOW_KEYPOINT_WORKFLOW_ID=
ROBOFLOW_SEGMENTATION_WORKFLOW_ID=

# Optional browser-facing aliases. Never place database or storage credentials in VITE_* values.
VITE_NEON_AUTH_URL=https://YOUR-AUTH-ENDPOINT.neonauth.REGION.aws.neon.tech/YOUR_PROJECT/auth
